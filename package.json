{
	"name": "durable-channel",
	"version": "0.1.0-rc.0",
	"description": "Durable Channel is a library for building durable, stateful, and type-safe communication channels between clients and servers.",
	"bugs": "https://github.com/grenierdev/durable-channel/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/grenierdev/durable-channel.git"
	},
	"license": "MIT",
	"engines": {
		"node": ">=24.4.0"
	},
	"type": "module",
	"main": "./dist/src/mod.js",
	"types": "./dist/src/mod.d.ts",
	"exports": {
		".": {
			"types": "./dist/src/mod.d.ts",
			"import": "./dist/src/mod.js"
		},
		"./storage/sqlite": {
			"types": "./dist/src/sqlite.d.ts",
			"import": "./dist/src/sqlite.js"
		}
	},
	"sideEffects": false,
	"scripts": {
		"lint": "biome check --write --unsafe .",
		"check": "tsc --noEmit",
		"test": "vitest run",
		"fmt": "biome format --write .",
		"prebuild": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
		"build": "tsc",
		"prepack": "npm run build",
		"publish": "npm publish --access public"
	},
	"dependencies": {
		"@valibot/to-json-schema": "^1.7.1",
		"openapi-types": "^12.1.3",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@hono/node-server": "^2.1.4",
		"@microsoft/agent-host-protocol": "0.9.0",
		"@types/node": "^24.13.3",
		"@types/ws": "^8.18.1",
		"fake-indexeddb": "^6.2.5",
		"hono": "^4.12.28",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3",
		"ws": "^8.21.0"
	}
}
